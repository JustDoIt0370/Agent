# Copy to .env.local and edit locally. The real file is ignored by Git.
# Non-empty values override the environment for the launched process.
AGENT_API_KEY=
# Paste your console's OpenAI-compatible base URL WITHOUT the final /v1.
AGENT_BASE_URL=
AGENT_MODEL=qwen-plus
AGENT_EXTRA_BODY_JSON={"enable_thinking":false}
